global SoftSwitches {
  struct ss {
    // the sense of these are all chosen so that a reset should set them to 0
    store80,  // should be 80store but can't lead with a number
    auxread,
    auxwrite,
    altzp,
    page2,
    hires,
    lcram_bank1, // 0 == bank2 (d000), 1 == bank1(c000)
    lcram_writeinh, // 0 == lcram writable, 1 == lcram write inhibited
    lcram_read, // 0 == ROM readable, 1 == lcram readable
    c8_select[3],  // owner of c800-cfff space, 0 if none
    slot_access, // whether the current address access is a slot access
    addr_decode[17], // decoded full address (if RAM)
    addr_decode_en // 1 == valid decoded address
  }
}


module soft_switch_manager (
  input clk,
  input rst,
  input addr_in[16],
  input addr_in_en,
  input rw,
  input bus_reset,
  output<SoftSwitches.ss> ss
) {
  const SS80STORE = 7b0000000;
  const AUXREAD   = 7b0000001;
  const AUXWRITE  = 7b0000010;
  const INTCXROM  = 7b0000011;
  const ALTZP     = 7b0000100;
  const SLOTC3ROM = 7b0000101;
  const PAGE2     = 7b0101010;
  const HIRES     = 7b0101011;
  
  .clk(clk), .rst(rst) {
    // the sense of these are all chosen so that a reset should set them to 0
    dff ss_80store;
    dff ss_auxread;
    dff ss_auxwrite;
    dff ss_intcxrom;
    dff ss_altzp;
    dff ss_slotc3rom;
    dff ss_page2;
    dff ss_hires;
    dff ss_lcram_bank1; // 0 == bank2 (d000), 1 == bank1(c000)
    dff ss_lcram_writeinh; // 0 == lcram writable, 1 == lcram write inhibited
    dff ss_lcram_read; // 0 == ROM readable, 1 == lcram readable
    dff ss_lcram_writeinh_last;  // 1 == prev access was a lcram write enabler, 0 == it wasn't 
    dff ss_c8_select[3];
    dff ss_slot_access;
    dff addr_decode[17];
    dff addr_decode_en;
  }

  always {
    ss.store80 = ss_80store.q;
    ss.auxread = ss_auxread.q;
    ss.auxwrite = ss_auxwrite.q;
    ss.altzp = ss_altzp.q;
    ss.page2 = ss_page2.q;
    ss.hires = ss_hires.q;
    ss.lcram_bank1 = ss_lcram_bank1.q; // 0 == bank2 (d000), 1 == bank1(c000)
    ss.lcram_writeinh = ss_lcram_writeinh.q; // 0 == lcram writable, 1 == lcram write inhibited
    ss.lcram_read = ss_lcram_read.q; // 0 == ROM readable, 1 == lcram readable
    ss.c8_select = ss_c8_select.q;  // owner of c800-cfff space, 0 if none
    ss.slot_access = ss_slot_access.q; // whether the current address access is a slot access
    ss.addr_decode = addr_decode.q;
    ss.addr_decode_en = addr_decode_en.q;
    // only update soft switches once per cycle, when the address update hits
    if (addr_in_en) {
      // handle memory mapping soft switches
      if (addr_in[15:8] == 8hc0) {
        case (addr_in[7:1]) {
          SS80STORE: if (!rw) ss_80store.d = addr_in[0];
          AUXREAD: if (!rw) ss_auxread.d = addr_in[0];
          AUXWRITE: if (!rw) ss_auxwrite.d = addr_in[0];
          INTCXROM: if (!rw) ss_intcxrom.d = addr_in[0];
          ALTZP: if (!rw) ss_altzp.d = addr_in[0];
          SLOTC3ROM: if (!rw) ss_slotc3rom.d = addr_in[0];
          PAGE2: ss_page2.d = addr_in[0];
          HIRES: ss_hires.d = addr_in[0];
        }
      }
    
      // handle language card soft switches
      if (addr_in[15:4] == 12hc08) {
        ss_lcram_writeinh_last.d = addr_in[0] & rw;
        ss_lcram_bank1.d = addr_in[3];
        ss_lcram_read.d = (addr_in[1] == addr_in[0]);
        // if the last access would enable lcram writes, and this access would as well,
        // then we CLEAR the writeinh state (make writable).  Otherwise we set the
        // writeinh state.  This gyration is to keep the default sense (allow writes)
        // to be the 0 value in the register.
        if (addr_in[0]) {
          if (ss_lcram_writeinh_last.q && rw) {
            ss_lcram_writeinh.d = 0;
          }
          //ss_lcram_writeinh.d = !(ss_lcram_writeinh_last.q & addr_in[0] & rw);
        } else {
          ss_lcram_writeinh.d = 1; 
        }
      }
    
      // handle c8_select
      ss_slot_access.d = 0;
      if (addr_in[15:12] == 4hc) {
        if (addr_in[11] == 0 && addr_in[10:8] != 3b0) {
          //c1XX-c7xx
          if (!ss_intcxrom.q) {
            ss_c8_select.d = addr_in[10:8];
            ss_slot_access.d = 1;
          }
          if (addr_in[10:8] == 3b011) {
            // for slot 3, unless slotc3rom is set,
            // the access goes back to motherboard rom
            if (!ss_slotc3rom.q) {
              ss_c8_select.d = 3b0;
              ss_slot_access.d = 0;
            }
          }
        }
      }
      
      // handle CFFF release of c8_select
      if (addr_in == 12hfff) {
        ss_c8_select.d = 3b0;
      }
      
      // handle clearing all soft switches on reset
      if (!bus_reset) {
        ss_80store.d = 0;
        ss_auxread.d = 0;
        ss_auxwrite.d = 0;
        ss_intcxrom.d = 0;
        ss_altzp.d = 0;
        ss_slotc3rom.d = 0;
        ss_page2.d = 0;
        ss_hires.d = 0;
        ss_lcram_bank1.d = 0;
        ss_lcram_writeinh.d = 0;
        ss_lcram_read.d = 0;
        ss_lcram_writeinh_last.d = 0;
        ss_c8_select.d = 3b0;
      }
      
      addr_decode.d[15:0] = addr_in;
      addr_decode.d[16] = 0;
      addr_decode_en.d = 0;
      if (addr_in[15:12] == 4hc) {
        // nothing is ram in cxxx
        addr_decode_en.d = 0;
      } else if (addr_in[15:8] == 8h00 || addr_in[15:8] == 8h01) {
        // page 0 and 1 only affected by altzp
        addr_decode_en.d = 1;
        addr_decode.d[16] = ss_altzp.q;
      } else if (addr_in[15:14] == 2b11) {
        // since cxxx is already checked, this gets d,e,f
        addr_decode.d[16] = ss_altzp.q;
        if (ss_lcram_bank1.q && addr_in[13:12] == 2b01) {
          // access to d, bank1 changes the decode to c
          addr_decode.d[12] = 0;
        }
        if (rw && ss_lcram_read.q) {
          // set to read lcram
          addr_decode_en.d = 1;
        }
        if (!rw && !ss_lcram_writeinh.q) {
          // write and lcram write is not inhibited
          addr_decode_en.d = 1;
        }
      } else {
        if (rw) {
          addr_decode.d[16] = ss_auxread.q;
          addr_decode_en.d = 1;
        } else {
          addr_decode.d[16] = ss_auxwrite.q;
          addr_decode_en.d = 1;
        }
        if (ss_80store.q) {
          if (addr_in[15:11] == 5b00000) {
            // 0x0400-0x07ff
            addr_decode.d[16] = ss_page2.q;
            addr_decode_en.d = 1;
          } else if (ss_hires.q && addr_in[15:13] == 3b001) {
            // 0x2000-0x3fff
            addr_decode.d[16] = ss_page2.q;
            addr_decode_en.d = 1;
          }
        }
      }
    }
  }
}